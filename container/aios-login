#!/bin/sh
# Interactive entry to a running AIos machine:
#
#     kubectl exec -it -n aios aios -- aios
#
# The cockpit: three panes in one window, and you land in the prompt.
#
#   0  left, top      the cockpit's keys, then the agent prompt
#   1  left, bottom   the operator's shell (their own account, sudo for root
#                     moments; plain root only if the account does not exist)
#   2  right          the dashboard — every agent, what it is doing, and whether
#                     anything is stuck (python3 -m aios.supervisor)
#
# Pane 0 is about thirteen rows once the status bar and the pane borders are paid
# for. The welcome manifest is 21 lines and the cheat sheet is 15, so printing both
# scrolled 22 lines of them away before the prompt appeared and the manifest — the
# one screen that says why this machine exists — was never actually read in the
# cockpit. So: the keys here, sized to the pane, and the manifest on F4, in a window
# of its own at the width it is measured for. AIOS_SPLIT=0 still prints it inline.
#
# tmux was taken out of this path once, and for a good reason: the agent's
# never-quit loop ran in a detached pane with nobody reading it and nothing to stop
# it (skills/detached-agent-loop). It is back with the brake in the loop rather than
# in the person watching. The agent has step, wall-clock and identical-verdict
# budgets. Pane 2's loop is deterministic — it reads .aios/agent.jsonl and redraws,
# forever, for free — and the one model it may consult is the small one, rate
# limited, capped for the whole run, and silent while the journal has not changed.
# So an idle machine costs nothing, and detaching costs nothing.
#
#     AIOS_SPLIT=0 aios          no tmux: manifest and prompt on this terminal
#     AIOS_ADVICE=0 aios         cockpit, dashboard reads only — zero model calls
#     manual                     this machine's manual
#     F4                         the manifest, full width
#     tmux kill-server           end it all, every pane and client included
set -u

AIOS_ROOT="${AIOS_ROOT:-/aios}"
# Exported, not just set: the tmux server inherits this, and the status bar's
# reader resolves the journal and the generation counter against it.
export AIOS_ROOT
export PYTHONPATH="$AIOS_ROOT"
export PYTHONDONTWRITEBYTECODE=1
cd "$AIOS_ROOT" || exit 1

# Applying an update before the session starts is what makes "no reboot" true: new
# code is picked up by the next login, not by a pod restart. Never fatal — a machine
# that cannot reach its peer must still let you in.
if [ "${AIOS_AUTOUPDATE:-1}" = 1 ] && [ -n "${AIOS_UPDATE_URL:-}" ]; then
    python3 -m aios.update apply 2>&1 | sed 's/^/  update: /' || true
fi

# The machine names its operator, once, and remembers it.
AIOS_OPERATOR=$(python3 -m aios.identity --account 2>/dev/null || echo operator)
export AIOS_OPERATOR

# Split, and print the new pane's id.
#
# Two things here are version-dependent rather than constant, because this machine
# compiles its own tmux: the percentage flag changed spelling (`-p N` through 3.0,
# `-l N%` after), so the current one is tried and the old one is the fallback — a
# split that silently did not happen would leave the cockpit a pane short. And the
# id is captured because pane *indices* are positional and shift as panes are
# inserted, while `%3` names one pane for as long as it lives. Titles are set by id
# for that reason: a border that says "dashboard" over the shell would be worse
# than no border at all.
split() {
    where=$1
    percent=$2
    target=$3
    shift 3
    tmux -f "$CONF" split-window "$where" -l "$percent%" -t "$target" \
        -P -F '#{pane_id}' "$@" 2>/dev/null ||
        tmux -f "$CONF" split-window "$where" -p "$percent" -t "$target" \
            -P -F '#{pane_id}' "$@"
}

# Start a pane's real program, now that the pane has its final size.
#
# `send-keys` is the fallback rather than an error, for the same reason `split` has
# one: a respawn that silently did not happen would leave the human in a bare shell
# where the agent should be. It works even before the shell is up — the pty buffers
# what is typed at it until something reads.
start() {
    tmux -f "$CONF" respawn-pane -k -t "$1" "$2" 2>/dev/null ||
        tmux -f "$CONF" send-keys -t "$1" "$2" Enter
}

# Defined here, not inherited: aios-init has its own copies, but this script is also
# run directly as `aios`, and under `set -u` an undefined colour variable aborts the
# login outright — a cosmetic detail taking the whole session down with it.
if [ -n "${NO_COLOR:-}" ]; then
    DIM=''; WARN=''; OFF=''
else
    DIM=$(printf '\033[2m'); WARN=$(printf '\033[38;5;179m'); OFF=$(printf '\033[0m')
fi

# Say why there is no cockpit, rather than quietly handing over a bare prompt.
#
# This fell back silently once and the machine simply "looked old": tmux lives under
# /usr, which is the ephemeral layer, so recreating the pod removed it and the guard
# below stopped matching. No dashboard, no explanation, and the obvious conclusion
# was that the new image had shipped without one. A degraded mode that does not
# announce itself is indistinguishable from a regression.
if [ "${AIOS_SPLIT:-1}" != 0 ] && ! command -v tmux >/dev/null 2>&1; then
    printf '%s  no cockpit: tmux is not installed, so this is the plain prompt.%s\n' "$WARN" "$OFF"
    printf '%s  It is in the lockfile and a binary you built is cached — reinstall with:%s\n' "$DIM" "$OFF"
    printf '%s    emerge --usepkgonly --oneshot app-misc/tmux && exec aios%s\n\n' "$DIM" "$OFF"
fi

if [ "${AIOS_SPLIT:-1}" != 0 ] && command -v tmux >/dev/null 2>&1; then
    CONF=/etc/aios/tmux.conf
    SESSION="${AIOS_SESSION:-aios}"
    WINDOW="$SESSION:machine"

    if tmux -f "$CONF" has-session -t "$SESSION" 2>/dev/null; then
        exec tmux -f "$CONF" attach-session -t "$SESSION"
    fi

    # `exec bash -l` at the end of each pane on purpose: /quit, Ctrl-D or a crash in
    # the dashboard must not collapse the cockpit around a build still running in
    # pane 1. Leaving for real is C-b d (the machine keeps working) or `tmux
    # kill-server` (it does not).
    RUN_PROMPT="python3 -m aios.dashboard keys"
    RUN_PROMPT="$RUN_PROMPT; python3 -m aios.agent; exec bash -l"
    RUN_DASH="python3 -m aios.supervisor"
    RUN_DASH="$RUN_DASH; printf '\n  dashboard stopped — restart: python3 -m aios.supervisor\n'"
    RUN_DASH="$RUN_DASH; exec bash -l"

    # The shell pane is the operator's, not root's. The prompt and dashboard panes
    # stay uid 0 — identity.py is explicit that the agent has to emerge packages —
    # but the pane a human types commands into runs as the account this machine
    # minted for them, with wheel + sudo for the moments that need root. `su -`
    # rather than plain su, so it is the operator's own login environment and not
    # root's with a borrowed uid. Guarded on the account resolving: boot creates it,
    # but a boot where useradd failed must land in a root shell, not a pane that
    # exits on a user su cannot find.
    RUN_SHELL="exec bash -l"
    if id "$AIOS_OPERATOR" >/dev/null 2>&1 && command -v su >/dev/null 2>&1; then
        RUN_SHELL="exec su - $AIOS_OPERATOR"
    fi

    # Every pane starts as a login shell and is respawned with its real command
    # afterwards, because a program started in a pane that is about to be split
    # measures the wrong terminal. Both of these read their own size: the cheat sheet
    # sheds key rows to fit the pane's height, and the dashboard lays out its columns
    # from the pane's width. Started before the splits, they raced two tmux round
    # trips — 80 columns when Python won, 49 when tmux did, and tmux reflowing an
    # 80-column right-aligned panel into 49 shears it.
    HOLD="exec bash -l"
    tmux -f "$CONF" new-session -d -s "$SESSION" -n machine "$HOLD"
    PROMPT=$(tmux -f "$CONF" display-message -p -t "$WINDOW" '#{pane_id}')

    # Order matters. A split inserts the new pane immediately after its target in the
    # window's pane list, and that list is what pane *indices* count — so taking the
    # full-height right column first and splitting the left column second lands the
    # panes on 0 (prompt), 1 (shell), 2 (dashboard), which is what F1/F2/F3 bind to.
    DASHBOARD=$(split -h 38 "$WINDOW.0" "$HOLD")
    SHELLPANE=$(split -v 35 "$WINDOW.0" "$HOLD")

    # If any of those ids came back empty, fall back to the indices above rather than
    # passing an empty target: `-t ""` means *the active pane*, which would put all
    # three titles on one pane and land the human in the shell instead of the prompt.
    : "${PROMPT:=$WINDOW.0}" "${SHELLPANE:=$WINDOW.1}" "${DASHBOARD:=$WINDOW.2}"

    # The geometry is final from here. The shell pane is respawned like the others
    # — by the id captured at creation, never by index, because indices are
    # positional and a live session's need not match creation order.
    start "$DASHBOARD" "$RUN_DASH"
    start "$SHELLPANE" "$RUN_SHELL"
    start "$PROMPT" "$RUN_PROMPT"

    tmux -f "$CONF" select-pane -t "$PROMPT" -T prompt
    tmux -f "$CONF" select-pane -t "$SHELLPANE" -T shell
    tmux -f "$CONF" select-pane -t "$DASHBOARD" -T dashboard
    tmux -f "$CONF" select-pane -t "$PROMPT"   # the prompt, and it stays the prompt
    exec tmux -f "$CONF" attach-session -t "$SESSION"
fi

python3 -m aios.welcome
exec python3 -m aios.agent "$@"
