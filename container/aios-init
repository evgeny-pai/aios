#!/bin/sh
# PID 1 on an AIos node.
#
# Not a real init — there is no hardware to bring up in a container, and pretending
# otherwise would be theatre. What it does do is the honest container equivalent:
# check the userland is intact, report each fact it verified, render the welcome
# screen, and hand the terminal to the agent.
#
# It deliberately never exits. A pod whose PID 1 returns is a CrashLoopBackOff, and
# an OS that dies when you close the terminal is not an OS.

set -u

AIOS_ROOT="${AIOS_ROOT:-/aios}"
export PYTHONPATH="$AIOS_ROOT"
export PYTHONDONTWRITEBYTECODE=1
cd "$AIOS_ROOT" || exit 1

if [ -n "${NO_COLOR:-}" ]; then
    DIM=''; OK=''; WARN=''; ACCENT=''; OFF=''
else
    DIM=$(printf '\033[2m')
    OK=$(printf '\033[38;5;79m')
    WARN=$(printf '\033[38;5;179m')
    ACCENT=$(printf '\033[38;5;117m')
    OFF=$(printf '\033[0m')
fi

ical=0  # required checks that failed — a boot with any of these is not "clean"

step() {
    # step <ok|warn> <label> <detail>
    if [ "$1" = ok ]; then
        mark="${OK}  ok  ${OFF}"
    else
        mark="${WARN}  ..  ${OFF}"
        ical=$((ical + 1))
    fi
    printf '%s%s%-16s%s %s\n' "$mark" "$DIM" "$2" "$OFF" "$3"
}

# Informational: absent credentials are a degraded agent, not a broken machine, so
# this must not cost the boot its generation.
note() {
    printf '%s%s%-16s%s %s\n' "${WARN}  ..  ${OFF}" "$DIM" "$1" "$OFF" "$2"
}

py() { python3 -c "$1" 2>/dev/null; }

printf '\n%s  AIos init%s\n' "$ACCENT" "$OFF"

step ok "rootfs" "$(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-gentoo}") $(uname -m)"
step ok "kernel" "$(uname -sr)"

pyver=$(py 'import sys; print(".".join(map(str, sys.version_info[:3])))')
[ -n "$pyver" ] && step ok "python" "$pyver" || { step warn "python" "MISSING — the userland cannot run"; }

forgever=$(py 'import forge; print(forge.__version__)')
[ -n "$forgever" ] && step ok "forge" "$forgever" || step warn "forge" "not importable"

spec=$(py '
from forge import spec
s = spec.load("aios.toml")
print(f"{len(s.intents)} intents, {len(s.all_probes())} probe(s)")
')
[ -n "$spec" ] && step ok "machine spec" "$spec" || step warn "machine spec" "aios.toml unreadable"

lock=$(py '
from forge import lock
l = lock.load("aios.lock.json")
short = l["digest"][7:19]
print(short + "... " + str(len(l["packages"])) + " packages")
')
[ -n "$lock" ] && step ok "lockfile" "$lock" || step warn "lockfile" "absent or digest mismatch"

# /etc/portage is DERIVED, so derive it — every boot, from the lockfile.
#
# It is not on a volume and it must not be: persisting it would let it drift from
# the lockfile that is supposed to define it, which is the one thing this project
# cannot allow. But nothing was regenerating it either, and the gap was expensive.
# A recreated pod came up with the stock catalyst make.conf, which meant MAKEOPTS
# was UNSET — every package compiled on one core, on a machine given eight — and
# FEATURES lost `buildpkg`, so builds stopped feeding the binary package cache the
# rest of the network pulls from. Both failures are silent: emerge is perfectly
# happy to be slow and to produce nothing reusable.
#
# Rendering here also means the lockfile is the only way to change build policy.
# Hand-editing /etc/portage now survives exactly until the next boot, which is the
# correct lifetime for an edit that bypassed the spec.
render=$(py '
from forge import lock, portage
l = lock.load("aios.lock.json")
print(len(portage.render(l, "/", lock_path="aios.lock.json", overlay="/aios/overlay")))
')
if [ -n "$render" ]; then
    step ok "portage config" "$render files from the lockfile"
else
    step warn "portage config" "NOT rendered — MAKEOPTS/FEATURES/USE are stage3 defaults"
fi

# Reinstall what this machine had built, from what this machine built it into.
#
# /usr lives in the image layer and /var/db/pkg is deliberately not a volume (see the
# manifest: a persisted package database would outlive the binaries it describes and
# insist tmux is installed with no /usr/bin/tmux). The consequence is that every pod
# recreate came up with an empty userland — distcc, ccache, everything compiled here,
# gone — and a human had to remember to put it back.
#
# So put it back from the binary package cache, which IS a volume. FEATURES=buildpkg
# means every build this node ever did already left a reusable package behind, so this
# is a copy rather than a compile: 23 packages came back in seconds, where building
# them took the better part of an hour. That is the project's own claim — the machine
# reconstitutes from a lockfile plus its own cache — applied to its own boot.
#
# It asks for the CACHED ATOMS, not for @aios. `emerge --usepkgonly @aios` aborts in
# dependency resolution on the first member with no binary package — "there are no
# binary packages to satisfy dev-vcs/git" — and installs NOTHING, including the ten
# packages it did have. --keep-going does not cover that: the failure is resolution,
# not a build. So aios.repo.cached-atoms reports the intersection and that is what is
# emerged.
#
# --usepkgonly so a restore can never quietly become an hour-long compile; --noreplace
# so an already-present package is left alone. ccache and distcc are off for this one
# emerge because they are part of what is being restored, and portage warns about a
# FEATURE whose binary is not there yet.
restore_atoms=$(python3 -m aios.repo cached-atoms 2>/dev/null || echo '')
if [ "${AIOS_RESTORE:-1}" = 1 ] && [ -n "$restore_atoms" ]; then
    # One unsatisfiable atom must not zero the whole restore. emerge answers a
    # masked or unresolvable member by aborting RESOLUTION — nothing installs at
    # all, and --keep-going does not apply because no build ever started. This
    # happened, twice in one cache: a ~arm64-masked x11vnc binpkg zeroed a boot's
    # whole 425-atom restore while this step still said ok, and an xorg-drivers
    # binpkg whose xorg-server[udev] dependency had no binary failed the retry the
    # same way. So the failure emerge reports is read back — it names either the
    # atom itself ('could satisfy "x"' / 'to satisfy "x"') or the argument whose
    # dependency chain broke ('required by "x" [argument]') — the named atoms are
    # dropped, and the rest get another try. Bounded, because a failure that names
    # nothing (full disk, broken portage) would loop forever.
    have=$(echo "$restore_atoms" | wc -w | tr -d ' ')
    : >/var/log/aios-restore.log
    # The binpkg index and the directory can disagree — a hand-removed gpkg
    # leaves an index entry emerge will happily plan and then die on ("Tried to
    # use non-existent binary"). portage's own remedy, run first, best-effort.
    emaint binhost --fix >>/var/log/aios-restore.log 2>&1 || true
    restored=0 skipped=''
    # Under a deadline, because a bad package can HANG rather than fail: a cached
    # redis gpkg deadlocked portage's unpack (zstd waiting on a pipe nobody was
    # reading) reproducibly, and a restore that never returns is a boot that never
    # finishes. INT first so emerge can clean up its children. If coreutils'
    # timeout is somehow absent, the restore runs bare rather than not at all.
    deadline=''
    command -v timeout >/dev/null 2>&1 &&
        deadline="timeout -s INT -k 60 ${AIOS_RESTORE_TIMEOUT:-1800}"
    for _try in 1 2 3 4 5; do
        # Word splitting is wanted here: the atoms are one emerge command line,
        # and $deadline is the timeout prefix or nothing.
        # shellcheck disable=SC2086
        FEATURES="-ccache -distcc" $deadline \
            emerge --usepkgonly --noreplace --keep-going \
            --quiet --quiet-build=y $restore_atoms >>/var/log/aios-restore.log 2>&1
        code=$?
        if [ "$code" = 0 ]; then
            restored=1
            break
        fi
        drop=$({
            sed -n 's/.*satisfy "\([^"]*\)".*/\1/p' /var/log/aios-restore.log
            sed -n 's/.*dependency required by "\([^"]*\)" \[argument\].*/\1/p' \
                /var/log/aios-restore.log
            # A stale index entry — the file is gone but Packages still lists it,
            # and emaint --fix above does not always prune it. Names cat/pkg-ver,
            # so split the version off the way portage spells it.
            sed -n "s/.*non-existent binary for '\([^']*\)'.*/\1/p" \
                /var/log/aios-restore.log |
                sed 's/-r[0-9][0-9]*$//; s/-[0-9][^-]*$//'
        } | sort -u)
        if [ "$code" = 124 ]; then
            # Killed by the deadline. The atom to drop is whatever emerge was on —
            # the last "Emerging binary (N of M) cat/pkg-ver::repo" line, with the
            # version split off the way portage spells it (-rN first, then -<v>).
            hung=$(sed -n 's/.*Emerging binary ([^)]*) \([^ ]*\)::.*/\1/p' \
                /var/log/aios-restore.log | tail -1 |
                sed 's/-r[0-9][0-9]*$//; s/-[0-9][^-]*$//')
            drop="$drop $hung"
        fi
        new=''
        for atom in $drop; do
            # The log accumulates across retries, so an atom already dropped shows
            # up again here; only one still on the command line is progress.
            case " $restore_atoms " in *" $atom "*) new="$new $atom" ;; *) continue ;; esac
            # shellcheck disable=SC2086
            restore_atoms=$(printf '%s\n' $restore_atoms | grep -vx "$atom" | tr '\n' ' ')
        done
        [ -n "$new" ] || break   # nothing nameable left to drop
        skipped="$skipped$new"
    done
    back=$(ls -d /var/db/pkg/*/* 2>/dev/null | wc -l | tr -d ' ')
    if [ "$restored" = 1 ] && [ -z "$skipped" ]; then
        step ok "packages" "$back installed, $have restorable from this node's own cache"
    elif [ "$restored" = 1 ]; then
        step ok "packages" "$back installed; skipped$skipped (unsatisfiable — /var/log/aios-restore.log)"
    else
        note "packages" "restore did not complete — see /var/log/aios-restore.log"
    fi
else
    note "packages" "no binpkg cache yet — first build on this node compiles from source"
fi

# The operator account, made real at boot rather than at first login. Everything
# it consists of — the /etc/passwd entry, /home, group wheel membership, the
# /etc/sudoers.d/aios-operator drop-in — is the ephemeral layer, so a pod recreate
# erases all of it while the handle itself survives on the state volume. Recreating
# it here means the login path FINDS the account instead of racing to make it, and
# the cockpit's shell pane can be a person with sudo instead of root. The agent
# session stays uid 0 (identity.py is explicit: it has to emerge packages); this is
# the other half, the human's half. After the restore on purpose: that is what puts
# the sudo binary back, and a grant reported before its binary exists would be the
# kind of claim this boot screen exists to not make.
# stderr is KEPT, not sent to /dev/null. A boot reported "account not created" with no
# way to learn more, and running the same call by hand afterwards succeeded — no error,
# no repro, and a real regression left sitting in the boot path. The reason now travels
# two ways: a traceback lands in operator_err, and identity.ensure_account records
# useradd's own words to /var/log/aios-operator.log.
operator_err=$(mktemp 2>/dev/null || echo /tmp/aios-operator.err)
operator=$(python3 -m aios.identity --account 2>"$operator_err" || echo '')
if [ -n "$operator" ] && id "$operator" >/dev/null 2>&1; then
    # Put the node's name in the operator's prompt too.
    #
    # /etc/profile.d already sets a PS1 carrying $AIOS_HOSTNAME, but `su -` gives a login
    # shell that sources profile.d FIRST and the skeleton ~/.bashrc AFTER, and that file
    # sets its own `\u@\h` prompt — where \h is the KERNEL hostname, which stays `aios`
    # because sethostname(2) needs CAP_SYS_ADMIN. So the operator's shell was the one
    # place still reading `aios`, which is exactly the signal that makes a current node
    # look like it is running old code.
    #
    # Appended last, marker-guarded so repeated boots converge instead of accumulating,
    # and it reads $AIOS_HOSTNAME at prompt-expansion time rather than baking the name —
    # the generation changes on every boot and the home directory may outlive it.
    home=$(getent passwd "$operator" 2>/dev/null | cut -d: -f6)
    if [ -n "$home" ] && [ -d "$home" ] && ! grep -q 'aios-hostname-prompt' "$home/.bashrc" 2>/dev/null; then
        {
            printf '\n# aios-hostname-prompt: last word on PS1, after the skeleton bashrc\n'
            printf 'PS1='"'"'\\[\\033[38;5;117m\\]${AIOS_HOSTNAME:-\\h}\\[\\033[2m\\]:\\w\\[\\033[0m\\] \\$ '"'"'\n'
        } >> "$home/.bashrc" 2>/dev/null || true
        chown "$operator" "$home/.bashrc" 2>/dev/null || true
    fi
    if command -v sudo >/dev/null 2>&1; then
        step ok "operator" "$operator — wheel, passwordless sudo"
    else
        step ok "operator" "$operator — wheel; sudo not installed yet"
    fi
else
    why=$(python3 -m aios.identity --why 2>/dev/null || true)
    [ -z "$why" ] && why=$(tail -1 "$operator_err" 2>/dev/null)
    note "operator" "account not created — ${why:-no reason recorded}; shell pane falls back to root"
fi
rm -f "$operator_err" 2>/dev/null || true

# Services this node offers the network, started here rather than by hand.
#
# The Service objects (aios-repo:8080 for the tree/binpkgs/src, :3632 for distccd)
# resolve the moment the pod reports Ready, so anything not running by then is a
# dangling endpoint as far as a peer is concerned — it gets a refused connection from
# a name that claims to be a repo. Starting them at boot is what makes the published
# surface true. Neither is required for the machine to BE itself, so a failure here is
# a note rather than a failed check, and must not cost the boot its generation.
serving() { { netstat -ltn 2>/dev/null || ss -ltn 2>/dev/null; } | grep -q "[:.]$1 "; }

if ! serving 8080; then
    (python3 -m aios.repo serve >>/var/log/aios-repo.log 2>&1 &) 2>/dev/null
    sleep 1
fi
if serving 8080; then
    step ok "repo server" "tree, binpkgs and src on :8080"
else
    note "repo server" "not listening on :8080 — see /var/log/aios-repo.log"
fi

# distccd: this node ACCEPTS compile jobs, it does not only send them. Without it the
# mesh has clients and no capacity, which is why `aios.mesh distcc` reports an empty
# host list and every build runs wherever it was started.
#
# The allow list is the private ranges rather than one CIDR because the client may be
# in this pod (127.0.0.1), another pod (the cluster's pod CIDR), or another machine on
# the LAN reaching in through a forwarded port — and distccd refuses, rather than
# ignores, an address it was not told about. It is an unauthenticated protocol, so the
# cluster boundary is doing the real confinement here: kind-cluster.yaml binds no host
# ports, so nothing outside reaches :3632 without an explicit forward.
if command -v distccd >/dev/null 2>&1; then
    if ! serving 3632; then
        install -d -o distcc -g distcc /var/log/distcc 2>/dev/null || true
        distccd --daemon --user distcc \
            --allow 127.0.0.1/32 --allow 10.0.0.0/8 \
            --allow 172.16.0.0/12 --allow 192.168.0.0/16 \
            --port 3632 --jobs "${AIOS_DISTCC_JOBS:-6}" \
            --log-file /var/log/distcc/distccd.log \
            --log-level "${AIOS_DISTCCD_LOG_LEVEL:-info}" 2>/dev/null || true
        sleep 1
    fi
    if serving 3632; then
        step ok "distccd" "accepting compile jobs on :3632"
    else
        note "distccd" "installed but not listening on :3632"
    fi
else
    note "distccd" "sys-devel/distcc not installed — this node sends but cannot accept"
fi

# Self-update: poll this project's own git remote and promote a new commit through
# the same gate-then-swap `aios.update` already uses for a peer's release (see
# aios/update.py's git-apply). A lone node has no peer to publish to it, but it
# always has the remote its own code came from, so that is the default source of
# truth here rather than something left unconfigured until a peer exists.
#
# A background loop, not a single check: PID 1 never exits, so this runs for the
# life of the pod, same shape as the repo server and distccd started above. Each
# iteration is one short-lived `git-apply` invocation rather than a long-running
# Python loop — cheap to reason about, and a stuck iteration cannot wedge the next
# one since there is no shared state beyond files on disk.
if [ "${AIOS_AUTOUPDATE:-1}" = 1 ] && [ -n "${AIOS_GIT_REMOTE:-}" ]; then
    (
        while :; do
            python3 -m aios.update git-apply >>/var/log/aios-selfupdate.log 2>&1 || true
            sleep "${AIOS_GIT_POLL_INTERVAL:-300}"
        done
    ) &
    step ok "self-update" "polling ${AIOS_GIT_BRANCH:-main}@${AIOS_GIT_REMOTE} every ${AIOS_GIT_POLL_INTERVAL:-300}s"
else
    note "self-update" "AIOS_GIT_REMOTE not set — this node will not update itself"
fi

# Skills mesh: push this node's skills/*/SKILL.md to ConductorAI, autonomously,
# same shape as the self-update loop just above — one short-lived invocation per
# tick rather than a long-running Python process. aios.skills.push() never raises
# and never blocks past its own timeout, so a daemon that is down or slow costs
# this loop nothing and the next tick tries again.
#
# No AIOS_GIT_REMOTE-style gate: unlike self-update, there is no "off" case worth
# naming separately — a mesh that is not there is already this loop's normal
# result (mesh.endpoint() always resolves to something, reachable or not), and
# aios.skills.push logs its own one-line outcome either way.
if [ "${AIOS_SKILLS_PUSH:-1}" = 1 ]; then
    (
        while :; do
            python3 -m aios.skills push >>/var/log/aios-skills.log 2>&1 || true
            sleep "${AIOS_SKILLS_PUSH_INTERVAL:-300}"
        done
    ) &
    step ok "skills mesh" "pushing skills/ to ConductorAI every ${AIOS_SKILLS_PUSH_INTERVAL:-300}s"
else
    note "skills mesh" "AIOS_SKILLS_PUSH=0 — this node keeps its skills to itself"
fi

# Skills mesh (read direction): pull skills other nodes have pushed into
# .aios/skills-mesh/, the read half of the loop just above. Same shape: one
# short-lived invocation per tick, since=<last successful pull's watermark>
# persisted at .aios/skills-pull.json so a restarted pod resumes instead of
# re-asking for the mesh's entire skill history. aios.skills.pull() never
# raises. Writes outside skills/ deliberately — skills/ is replaced wholesale
# by every self-update (see aios.skills.pull's docstring).
if [ "${AIOS_SKILLS_PULL:-1}" = 1 ]; then
    (
        while :; do
            python3 -m aios.skills pull >>/var/log/aios-skills-pull.log 2>&1 || true
            sleep "${AIOS_SKILLS_PULL_INTERVAL:-300}"
        done
    ) &
    step ok "skills mesh (pull)" "pulling mesh skills every ${AIOS_SKILLS_PULL_INTERVAL:-300}s"
else
    note "skills mesh (pull)" "AIOS_SKILLS_PULL=0 — this node only shares, never reads others' skills"
fi

# Same reasoning as the skills push just above, for a different gap: ConductorAI's
# own view of "is there an aios node here" comes from probing docker for a
# container it manages itself, which a Kubernetes pod can never be — so it reports
# none, and repo_context serves whatever memory notes happen to be lying around
# instead (observed live: 9-11 day old notes about a DIFFERENT machine, presented
# as current). This node reporting its own measured state — generation, lock
# digest, packages actually on disk — is the fix, since repo_status is one row
# per repo, last-write-wins, so a fresh push supersedes stale ones with no need to
# find and edit anything.
if [ "${AIOS_STATUS_PUSH:-1}" = 1 ]; then
    (
        while :; do
            python3 -m aios.status push >>/var/log/aios-status.log 2>&1 || true
            sleep "${AIOS_STATUS_PUSH_INTERVAL:-300}"
        done
    ) &
    step ok "status mesh" "reporting live status to ConductorAI every ${AIOS_STATUS_PUSH_INTERVAL:-300}s"
else
    note "status mesh" "AIOS_STATUS_PUSH=0 — this node does not report itself"
fi

# The generation is earned, not assumed: only a boot whose required checks all
# passed counts as this machine having come up again.
#
# Counted HERE, above the announcement, and that ordering is the fix to a real bug: the
# buzz announce reads identity.hostname(), which reads the counter, so announcing first
# published every node one generation behind itself — a node that had just booted as
# #12 introduced itself to the whole mesh as aios-11, and kind 0 is replaceable, so
# that understatement stood until the next boot. The relay's view of which incarnation a
# peer is running is exactly the thing generations exist to make legible.
#
# Safe to move: every check that can cost the boot its generation (`step warn`, which
# increments ical) runs in the userland section far above this point — the services,
# the announcement and the naming below are all reported with `note` when they fail,
# because a node with no relay is still a working node.
if [ "$ical" -eq 0 ]; then
    gen=$(python3 -m aios.generation bump 2>/dev/null || echo '')
    [ -n "$gen" ] && step ok "generation" "#$gen"
else
    note "generation" "not counted — $ical required check(s) failed"
fi

# Register on the buzz relay, if there is one.
#
# ORDERING IS LOAD-BEARING and this block must stay below the two above it. What a
# node announces is MEASURED, not declared: aios.buzz.capability probes the repo
# server on :8080 and distccd on :3632 to decide what this node offers. Announcing
# before those daemons are up would publish a node that advertises nothing, and kind 0
# is replaceable — so the understatement would stand until the next boot, and every
# peer deciding whether to ask this machine for a package would read it.
#
# Never fatal, and never a required check. A node with no relay is a working node that
# nobody has introduced yet; treating that as a boot failure would make the whole
# machine depend on a service it does not need in order to build anything.
if [ "${AIOS_BUZZ:-1}" = 1 ]; then
    buzz_line=$(python3 -m aios.buzz announce 2>&1 | head -1)
    case "$buzz_line" in
        announced*) step ok "buzz" "$buzz_line" ;;
        *) note "buzz" "not registered — ${buzz_line:-no relay at ${AIOS_BUZZ_URL:-the default}}" ;;
    esac

    # Answer other nodes' questions, for as long as this machine is up.
    #
    # A background loop for the same reason the self-update poll above is one: PID 1
    # never exits, so this lives as long as the pod. It only ever answers STRUCTURED
    # questions from a closed set, from local measurement — it does not read prose and
    # no model is involved, so nothing a peer writes can steer this machine. See the
    # answering section of aios/buzz.py for why that constraint is not negotiable.
    #
    # Started even when the announce above failed: a relay that is down now may be up
    # in a minute, and the loop reports and retries rather than exiting.
    if [ "${AIOS_BUZZ_RESPOND:-1}" = 1 ]; then
        (python3 -m aios.buzz serve "${AIOS_BUZZ_POLL_INTERVAL:-60}" \
            >>/var/log/aios-buzz.log 2>&1 &) 2>/dev/null
        step ok "buzz responder" "answering questions every ${AIOS_BUZZ_POLL_INTERVAL:-60}s → /var/log/aios-buzz.log"
    else
        note "buzz responder" "AIOS_BUZZ_RESPOND=0 — this node answers nobody"
    fi
else
    note "buzz" "AIOS_BUZZ=0 — this node will not announce itself"
fi

if [ -n "${ANTHROPIC_API_KEY:-}${ANTHROPIC_AUTH_TOKEN:-}" ]; then
    step ok "ai provider" "${AIOS_MODEL:-claude-haiku-4-5-20251001}"
else
    note "ai provider" "no credentials — agent will run degraded"
fi

# Name this incarnation: aios-<generation>-<the name the machine minted for itself>.
#
# Three pods built from one spec are all called `aios`, which is how a stale image got
# mistaken for a fresh one and how a node reported code it was not running. The name
# carries the generation precisely because that is the part that changes and the part
# that misleads.
#
# The kernel hostname is best-effort and usually will NOT change: sethostname(2) needs
# CAP_SYS_ADMIN in the UTS namespace and this pod does not have it. So the name is made
# authoritative where a human actually reads it — the environment and the shell prompt —
# rather than being reported as set when the kernel refused.
nodehost=$(py 'from aios import identity; print(identity.hostname())')
if [ -n "$nodehost" ]; then
    hostname "$nodehost" 2>/dev/null || true
    export AIOS_HOSTNAME="$nodehost"
    # The export ONLY — no PS1 here. This file used to define one, and because it sorts
    # before /etc/profile.d/aios.sh ('-' is 0x2D, '.' is 0x2E) the image's plain `aios`
    # prompt was sourced afterwards and won every time: the variable was right, the
    # prompt was wrong, and the cockpit looked like it was running old code. aios.sh now
    # interpolates ${AIOS_HOSTNAME:-aios}, so exporting it first is exactly what is
    # needed and there is one prompt definition instead of two.
    printf 'export AIOS_HOSTNAME=%s\n' "$nodehost" \
        > /etc/profile.d/aios-hostname.sh 2>/dev/null || true
    if [ "$(hostname 2>/dev/null)" = "$nodehost" ]; then
        step ok "hostname" "$nodehost"
    else
        step ok "hostname" "$nodehost  (prompt and env; kernel hostname needs CAP_SYS_ADMIN)"
    fi
else
    note "hostname" "could not compose a node name"
fi

printf '\n'

# A boot log is not a 24-line screen — `kubectl logs` scrolls, and the pty k8s
# hands PID 1 reports an arbitrary default size. Left alone, the manifest budgets
# for 24 lines and clips the intent text to fit a height nobody actually has.
LINES="${AIOS_BOOT_LINES:-40}" python3 -m aios.welcome \
    || printf '  AIos %s — welcome screen unavailable\n\n' "${forgever:-0.1.0}"

# Hand over the terminal when there is one. `kubectl attach` gives PID 1 a tty;
# `kubectl logs` does not, and must not block on a read that never returns.
if [ -t 0 ]; then
    python3 -m aios.agent || true
    printf '\n%s  agent session ended. reattach with: kubectl exec -it aios -- aios%s\n' "$DIM" "$OFF"
fi

# Hand PID 1 to the reaper.
#
# This was `exec tail -f /dev/null`, which never calls wait(). Every orphan on this
# machine — a build killed mid-run, a backgrounded responder whose parent exited, the
# subshells started above — is reparented here and became a permanent zombie: a
# process-table entry with a valid PID that `kill -0` and `ps` both report as alive. It
# is also why a wait-for-death check could never pass in the pod, and why uptime
# accumulated zombies with nothing ever visibly failing (skills/pid1-does-not-reap-orphans).
#
# aios.reaper also handles SIGTERM, which `tail` could not: PID 1 is exempt from the
# DEFAULT action of every signal, so an unhandled TERM was ignored outright and each
# `kubectl delete pod` waited out terminationGracePeriodSeconds before SIGKILL.
exec python3 -m aios.reaper
